# iShare — optional server settings
# Copy this file to .env if you run the server locally with a custom setup.

PORT=3000
HOST=0.0.0.0

# Maximum devices in one room (2-20).
MAX_ROOM_PEERS=8

# Hard cap on simultaneous WebSocket connections for the whole server.
MAX_CONNECTIONS=500

# Comma-separated extra origins allowed to open the signaling WebSocket.
# Same-origin clients are always allowed. Leave empty for normal deployments.
# ALLOWED_ORIGINS=https://drop.example.com,https://staging.drop.example.com

# TURN is strongly recommended for transfers across the internet, especially
# behind symmetric NAT / corporate firewalls. Leave these empty for local use.
# TURN_URLS accepts a comma-separated list. Include a TCP/TLS entry for networks
# that block UDP: turns:host:5349?transport=tcp
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
#
# Option A — static credentials (simple, but every browser receives them):
# TURN_USERNAME=ishare
# TURN_CREDENTIAL=change-me
#
# Option B — time-limited credentials (recommended). Configure coturn with
# `use-auth-secret` and the same secret, then set TURN_URLS + TURN_SECRET here.
# The server signs a fresh username per /api/config request; the secret itself
# never reaches the browser. TURN_TTL is the credential lifetime in seconds.
# TURN_SECRET=change-me-long-random-secret
# TURN_TTL=3600

# Force relay-only ICE for diagnostics (default: all).
# ICE_TRANSPORT_POLICY=relay

# Advanced: supply a complete RTCConfiguration.iceServers array instead.
# When set, it replaces the STUN/TURN defaults above.
# ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478"],"username":"user","credential":"secret"}]
